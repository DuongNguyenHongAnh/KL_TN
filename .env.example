# ==============================================================================
# HỆ THỐNG GỢI Ý THỜI TRANG H&M (CHICSTYLE) - CẤU HÌNH MÔI TRƯỜNG MẪU (.env.example)
# Sao chép file này thành .env và thiết lập giá trị phù hợp cho từng máy / server.
# LƯU Ý: Không commit file .env chứa secrets thật lên Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH ĐƯỜNG DẪN KHO ẢNH DÙNG CHUNG (PORTABILITY & STORAGE)
# ------------------------------------------------------------------------------
# DATASET_ROOT: Đường dẫn thư mục gốc dữ liệu (hỗ trợ tương đối theo thư mục dự án)
DATASET_ROOT=.

# PRODUCT_IMAGE_ROOT: Đường dẫn thư mục chứa ảnh sản phẩm H&M
# - Trên một máy đơn: 'output/images' (tương đối theo BASE_DIR) hoặc đường dẫn tuyệt đối
# - Trên nhiều server / Docker: mount volume chung vào đường dẫn này (ví dụ: '/app/output/images')
PRODUCT_IMAGE_ROOT=output/images

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH BACKEND REST API & PUBLIC MEDIA URL (ĐA SERVER / CLIENT)
# ------------------------------------------------------------------------------
# BACKEND_API_URL: Địa chỉ nội bộ để Streamlit Web và WinForms Admin gọi API
# Mặc định: http://127.0.0.1:8000 (khi chạy cùng máy) hoặc http://<ip_server>:8000
BACKEND_API_URL=http://127.0.0.1:8000

# PUBLIC_MEDIA_BASE_URL: URL công khai trả về cho trình duyệt người dùng từ máy khác
# - Để trống nếu chạy localhost / demo cùng máy (Web Streamlit tự phục vụ thumbnail tối ưu)
# - Khi triển khai máy khác / mạng LAN: đặt IP hoặc domain công khai của server API
#   Ví dụ: http://192.168.1.100:8000 hoặc https://api.chicstyle.vn
PUBLIC_MEDIA_BASE_URL=

# ADMIN_API_KEY: Khóa bí mật quản trị viên dành cho WinForms Admin và API bảo vệ
ADMIN_API_KEY=kltn_admin_secret_2026

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI API (DÀNH CHO CHATBOT AI FASHION STYLIST)
# ------------------------------------------------------------------------------
# Lấy API Key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH EMAIL OTP XÁC MINH TÀI KHOẢN (BREVO REST API V3)
# ------------------------------------------------------------------------------
# Đăng ký tài khoản miễn phí 300 emails/ngày tại https://app.brevo.com/
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_NAME=Fashion Recommender
BREVO_SENDER_EMAIL=your_verified_sender_email@domain.com

# Brevo SMTP Relay (Dự phòng nếu dùng SMTP)
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=your_smtp_login_here
BREVO_SMTP_KEY=your_smtp_key_here

# Tùy chọn: Gmail SMTP (Sử dụng Google App Password 16 chữ số)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here
